<mxfile host="drawio" version="24.0.0"><diagram id="apage" name="Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a1" value="&lt;b style='font-size:20px'&gt;Dhaka Tesla Pool — System Architecture (MVP)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666'&gt;Browser → Next.js → Node.js API → PostgreSQL · all runnable with &lt;code&gt;docker compose up&lt;/code&gt;&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1100" height="50" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;Passenger&lt;/b&gt;&lt;br&gt;Nusrat · Rafiq · Shirin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="36" height="70" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;Driver&lt;/b&gt;&lt;br&gt;Jashim (Tesla: Bullet, 3 seats)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="36" height="70" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;mobile / desktop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220" y="300" width="150" height="90" as="geometry"/></mxCell><mxCell id="a5" value="docker compose (local &amp;amp; reproducible deploy) — services: web · api · db" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#2d6cdf;strokeWidth=2;verticalAlign=top;align=left;spacing=10;fontStyle=1;fontColor=#2d6cdf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="1300" height="640" as="geometry"/></mxCell><mxCell id="a6" value="web — Next.js (App Router, TypeScript)" style="swimlane;rounded=1;html=1;startSize=34;fontStyle=1;fontSize=14;horizontal=1;whiteSpace=wrap;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f4f8fe;" vertex="1" parent="1"><mxGeometry x="450" y="120" width="360" height="560" as="geometry"/></mxCell><mxCell id="a7" value="&lt;b&gt;Pages&lt;/b&gt;&lt;br&gt;/login · /signup&lt;br&gt;/passenger — request ride, fare estimate, live status, cancel, history&lt;br&gt;/driver — go online/offline, requests in my zone, accept, arrived → start → complete, history" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="a6"><mxGeometry x="15" y="50" width="330" height="130" as="geometry"/></mxCell><mxCell id="a8" value="&lt;b&gt;Components&lt;/b&gt;&lt;br&gt;RideRequestForm · FareBreakdown · RideStatusCard · PoolPassengerList&lt;br&gt;Loading / Empty / Error states" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="a6"><mxGeometry x="15" y="195" width="330" height="95" as="geometry"/></mxCell><mxCell id="a9" value="&lt;b&gt;lib/api.ts&lt;/b&gt; — typed fetch client&lt;br&gt;status refresh by polling every ~4 s&lt;br&gt;(no WebSockets in MVP)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="a6"><mxGeometry x="15" y="305" width="330" height="85" as="geometry"/></mxCell><mxCell id="a10" value="&lt;b&gt;next.config rewrites&lt;/b&gt;&lt;br&gt;/api/* → API_URL (server-side proxy)&lt;br&gt;browser sees one origin → httpOnly auth cookie just works" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="a6"><mxGeometry x="15" y="405" width="330" height="90" as="geometry"/></mxCell><mxCell id="a11" value="api — Node.js 22 + Express (TypeScript)" style="swimlane;rounded=1;html=1;startSize=34;fontStyle=1;fontSize=14;horizontal=1;whiteSpace=wrap;arcSize=4;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;" vertex="1" parent="1"><mxGeometry x="880" y="120" width="420" height="560" as="geometry"/></mxCell><mxCell id="a12" value="&lt;b&gt;1 · Middleware&lt;/b&gt;&lt;br&gt;helmet · cors · pino-http (request id) · rate-limit on /auth&lt;br&gt;authenticate (JWT in httpOnly cookie) · requireRole · validate (zod)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="a11"><mxGeometry x="15" y="50" width="390" height="85" as="geometry"/></mxCell><mxCell id="a13" value="&lt;b&gt;2 · Routes / Controllers&lt;/b&gt; (thin: parse → call service → respond)&lt;br&gt;/auth · /zones · /rides · /driver · /pools · /health" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="a11"><mxGeometry x="15" y="160" width="390" height="70" as="geometry"/></mxCell><mxCell id="a14" value="&lt;b&gt;3 · Services — all business rules live here&lt;/b&gt;&lt;br&gt;FareService · MatchingService · PoolService (seat claim)&lt;br&gt;RideStateMachine (allowed transitions) · PaymentService" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="a11"><mxGeometry x="15" y="255" width="390" height="85" as="geometry"/></mxCell><mxCell id="a15" value="&lt;b&gt;4 · Data access&lt;/b&gt;&lt;br&gt;Prisma Client · migrations · &lt;code&gt;$transaction&lt;/code&gt;&lt;br&gt;atomic seat-claim SQL + ride_events written in the same transaction" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="a11"><mxGeometry x="15" y="365" width="390" height="80" as="geometry"/></mxCell><mxCell id="a16" value="&lt;b&gt;Error handler&lt;/b&gt; → { error: { code, message } } with 400 / 401 / 403 / 404 / 409" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="a11"><mxGeometry x="15" y="470" width="390" height="60" as="geometry"/></mxCell><mxCell id="a17" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="a12" target="a13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a18" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="a13" target="a14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a19" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;strokeColor=#d79b00;" edge="1" parent="1" source="a14" target="a15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a20" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;br&gt;users · wallets · vehicles&lt;br&gt;zones · zone_distances&lt;br&gt;ride_requests · pools&lt;br&gt;pool_members · payments · ride_events&lt;br&gt;&lt;br&gt;&lt;i&gt;CHECK seats_taken ≤ capacity&lt;br&gt;partial UNIQUE indexes&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="200" width="300" height="280" as="geometry"/></mxCell><mxCell id="a21" value="&lt;b&gt;migrate + seed&lt;/b&gt; (runs before api starts)&lt;br&gt;prisma migrate deploy → seed:&lt;br&gt;Jashim + Bullet, Nusrat, Rafiq, Shirin, Dhaka zones" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="1380" y="540" width="300" height="90" as="geometry"/></mxCell><mxCell id="a22" value="" style="endArrow=block;endFill=1;html=1;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="a21" target="a20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a23" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="a2" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a24" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a25" value="HTTPS&lt;br&gt;pages + /api/*" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="a4" target="a6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a26" value="REST / JSON&lt;br&gt;(proxied)" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="a10" target="a11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a27" value="SQL · TCP 5432" style="endArrow=block;endFill=1;html=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="a15" target="a20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a28" value="&lt;b&gt;Health checks&lt;/b&gt;: db → pg_isready · api → GET /health (checks DB) · web waits for api healthy" style="text;html=1;align=left;fontSize=11;fontColor=#2d6cdf;" vertex="1" parent="1"><mxGeometry x="1330" y="650" width="380" height="40" as="geometry"/></mxCell><mxCell id="a29" value="&lt;b&gt;Concurrency: Bullet has 1 seat, Nusrat &amp;amp; Shirin claim it at the same instant&lt;/b&gt;&lt;br&gt;&lt;code&gt;UPDATE pools SET seats_taken = seats_taken + $seats&lt;br&gt;WHERE id = $pool AND status = 'ACCEPTED'&lt;br&gt;&amp;nbsp;&amp;nbsp;AND seats_taken + $seats &amp;lt;= capacity RETURNING id;&lt;/code&gt;&lt;br&gt;Postgres row-locks the pool: first UPDATE wins, second re-checks and matches 0 rows → &lt;b&gt;409 POOL_FULL&lt;/b&gt;. CHECK constraint is the safety net." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="560" height="130" as="geometry"/></mxCell><mxCell id="a30" value="Free-tier deployment (planned)" style="swimlane;rounded=1;html=1;startSize=34;fontStyle=1;fontSize=14;horizontal=1;whiteSpace=wrap;arcSize=4;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="640" y="740" width="1080" height="130" as="geometry"/></mxCell><mxCell id="a31" value="&lt;b&gt;Vercel (Hobby)&lt;/b&gt;&lt;br&gt;web — Next.js" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="a30"><mxGeometry x="20" y="45" width="250" height="65" as="geometry"/></mxCell><mxCell id="a32" value="&lt;b&gt;Render (Free web service)&lt;/b&gt;&lt;br&gt;api — Docker image · sleeps when idle" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="a30"><mxGeometry x="290" y="45" width="290" height="65" as="geometry"/></mxCell><mxCell id="a33" value="&lt;b&gt;Neon (Free)&lt;/b&gt;&lt;br&gt;managed PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="a30"><mxGeometry x="600" y="45" width="220" height="65" as="geometry"/></mxCell><mxCell id="a34" value="Fallback if a free tier is unavailable: same &lt;code&gt;docker compose&lt;/code&gt; on any VM" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="a30"><mxGeometry x="840" y="45" width="225" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="lpage" name="Ride lifecycle"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l1" value="&lt;b style='font-size:20px'&gt;Ride &amp;amp; Pool lifecycle — RideStateMachine&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666'&gt;Any transition not drawn here is rejected with 409 INVALID_TRANSITION. Every transition inserts a ride_events row in the same transaction.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1300" height="50" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b&gt;Passenger's ride_request.status&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="400" height="30" as="geometry"/></mxCell><mxCell id="l3" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="165" width="24" height="24" as="geometry"/></mxCell><mxCell id="l4" value="REQUESTED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="110" y="150" width="170" height="55" as="geometry"/></mxCell><mxCell id="l5" value="MATCHED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="170" height="55" as="geometry"/></mxCell><mxCell id="l6" value="DRIVER_ARRIVED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="690" y="150" width="170" height="55" as="geometry"/></mxCell><mxCell id="l7" value="STARTED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="980" y="150" width="170" height="55" as="geometry"/></mxCell><mxCell id="l8" value="COMPLETED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1270" y="150" width="170" height="55" as="geometry"/></mxCell><mxCell id="l9" value="CANCELLED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="545" y="380" width="170" height="55" as="geometry"/></mxCell><mxCell id="l10" value="passenger&lt;br&gt;requests" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l11" value="driver accepts, or&lt;br&gt;auto-joins open pool&lt;br&gt;(seat claimed)" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l4" target="l5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l12" value="driver:&lt;br&gt;arrived" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l5" target="l6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l13" value="driver:&lt;br&gt;start trip" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l6" target="l7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l14" value="driver: complete&lt;br&gt;fare final + payment" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l7" target="l8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l15" value="passenger cancels" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="l4" target="l9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="195" y="407"/></Array></mxGeometry></mxCell><mxCell id="l16" value="passenger cancels&lt;br&gt;(seat released)" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="l5" target="l9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l17" value="passenger cancels /&lt;br&gt;driver: no-show" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="l6" target="l9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l18" value="No cancel after STARTED" style="text;html=1;fontSize=11;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="980" y="220" width="200" height="30" as="geometry"/></mxCell><mxCell id="l19" value="&lt;b&gt;Pool (the Tesla's trip) pools.status&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="400" height="30" as="geometry"/></mxCell><mxCell id="l20" value="ACCEPTED&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;open: others may join&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontStyle=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="110" y="540" width="190" height="60" as="geometry"/></mxCell><mxCell id="l21" value="DRIVER_ARRIVED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontStyle=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="400" y="540" width="190" height="60" as="geometry"/></mxCell><mxCell id="l22" value="STARTED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontStyle=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="690" y="540" width="190" height="60" as="geometry"/></mxCell><mxCell id="l23" value="COMPLETED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="980" y="540" width="190" height="60" as="geometry"/></mxCell><mxCell id="l24" value="CANCELLED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="400" y="690" width="190" height="55" as="geometry"/></mxCell><mxCell id="l25" value="arrived" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l20" target="l21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l26" value="start" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l21" target="l22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l27" value="complete" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l22" target="l23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l28" value="every member&lt;br&gt;cancelled" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="l20" target="l24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="205" y="717"/></Array></mxGeometry></mxCell><mxCell id="l29" value="every member&lt;br&gt;cancelled" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="l21" target="l24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l30" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;• A pool is created when Jashim accepts a REQUESTED ride; its capacity is copied from Bullet (3).&lt;br&gt;• New riders may join only while the pool is ACCEPTED and seats are free (same pickup zone, drop-offs ≤ 3 km apart).&lt;br&gt;• Driver actions (arrived / start / complete) move the pool, and every active member's ride_request moves with it.&lt;br&gt;• Pool discount is locked when the trip STARTS — that's when we know who is actually sharing." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#fffbe6;strokeColor=#d6b656;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="650" width="740" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>