#9e9e9e;strokeWidth=1.5;dashed=1;endSize=12;startSize=12;" edge="1" parent="1" source="e16" target="e210"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="945" y="115"/><mxPoint x="945" y="380"/><mxPoint x="1425" y="380"/><mxPoint x="1425" y="543"/></Array></mxGeometry></mxCell><mxCell id="e319" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;rounded=0;endFill=0;startFill=0;strokeColor=#9e9e9e;strokeWidth=1.5;dashed=1;endSize=12;startSize=12;" edge="1" parent="1" source="e78" target="e95"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e320" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;rounded=0;endFill=0;startFill=0;strokeColor=#9e9e9e;strokeWidth=1.5;dashed=1;endSize=12;startSize=12;" edge="1" parent="1" source="e78" target="e99"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e321" value="" style="edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;entryX=1;entryY=0.5;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;rounded=0;endFill=0;startFill=0;strokeColor=#9e9e9e;strokeWidth=1.5;dashed=1;endSize=12;startSize=12;" edge="1" parent="1" source="e78" target="e116"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1405" y="115"/><mxPoint x="1405" y="340"/><mxPoint x="915" y="340"/><mxPoint x="915" y="497"/></Array></mxGeometry></mxCell><mxCell id="e322" value="" style="edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;entryX=1;entryY=0.5;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;rounded=0;endFill=0;startFill=0;strokeColor=#9e9e9e;strokeWidth=1.5;dashed=1;endSize=12;startSize=12;" edge="1" parent="1" source="e78" target="e120"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1405" y="115"/><mxPoint x="1405" y="350"/><mxPoint x="925" y="350"/><mxPoint x="925" y="523"/></Array></mxGeometry></mxCell><mxCell id="e323" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;rounded=0;endFill=0;startFill=0;strokeColor=#9e9e9e;strokeWidth=1.5;dashed=1;endSize=12;startSize=12;" edge="1" parent="1" source="e78" target="e165"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e324" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;rounded=0;endFill=0;startFill=0;strokeColor=#9e9e9e;strokeWidth=1.5;dashed=1;endSize=12;startSize=12;" edge="1" parent="1" source="e78" target="e69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e325" value="&lt;b&gt;Integrity rules (enforced in the database)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;pools&lt;/b&gt;: CHECK (seats_taken BETWEEN 0 AND capacity) — Bullet can never exceed 3 seats&lt;br&gt;• &lt;b&gt;pools&lt;/b&gt;: partial UNIQUE (vehicle_id) WHERE status IN ('ACCEPTED','DRIVER_ARRIVED','STARTED') — one active pool per Tesla&lt;br&gt;• &lt;b&gt;ride_requests&lt;/b&gt;: partial UNIQUE (passenger_id) WHERE status NOT IN ('COMPLETED','CANCELLED') — one active ride per passenger&lt;br&gt;• &lt;b&gt;ride_requests&lt;/b&gt;: CHECK (pickup_zone_id &amp;lt;&amp;gt; dropoff_zone_id)&lt;br&gt;• &lt;b&gt;pool_members&lt;/b&gt;: UNIQUE (ride_request_id) — a request is in at most one pool&lt;br&gt;• &lt;b&gt;payments&lt;/b&gt;: UNIQUE (pool_member_id) — no double charge&lt;br&gt;• &lt;b&gt;zone_distances&lt;/b&gt;: CHECK (from_zone_id &amp;lt;&amp;gt; to_zone_id)&lt;br&gt;&lt;br&gt;&lt;b&gt;Indexes&lt;/b&gt;&lt;br&gt;• ride_requests (status, pickup_zone_id, created_at) — driver's 'nearby requests' list&lt;br&gt;• ride_requests (passenger_id, created_at DESC) — passenger history&lt;br&gt;• pools (status, pickup_zone_id) — find an open pool to join&lt;br&gt;• ride_events (ride_request_id, created_at), (pool_id, created_at) — timelines" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#fffbe6;strokeColor=#d6b656;arcSize=3;spacing=10;fontSize=12;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="420" height="560" as="geometry"/></mxCell><mxCell id="e326" value="&lt;b&gt;Enums&lt;/b&gt;&lt;br&gt;user_role: PASSENGER · DRIVER&lt;br&gt;ride_status: REQUESTED · MATCHED · DRIVER_ARRIVED · STARTED · COMPLETED · CANCELLED&lt;br&gt;pool_status: ACCEPTED · DRIVER_ARRIVED · STARTED · COMPLETED · CANCELLED&lt;br&gt;payment_method: CASH · TESLAPAY  ·  payment_status: PENDING · PAID · FAILED&lt;br&gt;&lt;br&gt;&lt;b&gt;Money&lt;/b&gt; — stored as integer &lt;b&gt;paisa&lt;/b&gt; (৳1 = 100 paisa): exact, no floating-point drift; format only in the UI.&lt;br&gt;&lt;br&gt;&lt;b&gt;Fare (worked example, assumed seed values)&lt;/b&gt;&lt;br&gt;fare = base 3000 + 1200/km × distance − pool discount (25% of distance charge if ≥2 riders)&lt;br&gt;Nusrat, Banani→Mohakhali 2.5 km: 3000 + 3000 − 750 = &lt;b&gt;5250&lt;/b&gt; (৳52.50)&lt;br&gt;Rafiq, Banani→Gulshan 1 3.0 km: 3000 + 3600 − 900 = &lt;b&gt;5700&lt;/b&gt; (৳57.00)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#fffbe6;strokeColor=#d6b656;arcSize=3;spacing=10;fontSize=12;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1440" y="700" width="440" height="360" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>